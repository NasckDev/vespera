{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Jogar (Godot .NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:GODOT}",
      "args": ["--path", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Smoke test",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:GODOT}",
      "args": ["--headless", "--path", "${workspaceFolder}", "--", "--smoke-test"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    }
  ]
}
