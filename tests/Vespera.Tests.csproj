<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Testes GdUnit4 da lógica pura (src/Core). GdUnit4 v5 roda testes sem o runtime do Godot,
    então `dotnet test` funciona sem a engine instalada. Testes que precisarem de nós/cenas
    devem usar [RequireGodotRuntime] e a variável GODOT_BIN (ver tests/README.md).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Vespera.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="gdUnit4.api" Version="5.0.0" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
    <PackageReference Include="gdUnit4.analyzers" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- gdUnit4.api traz Godot.SourceGenerators por dependência; aqui não há scripts Godot, então removemos. -->
  <Target Name="RemoveGodotSourceGenerators" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Godot.SourceGenerators'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\src\Core\Vespera.Core.csproj" />
  </ItemGroup>

  <!-- Os testes carregam os JSON reais do jogo (src/Data, incluindo maps.json) e o atlas para validar dados e regras juntos. -->
  <ItemGroup>
    <None Include="..\src\Data\*.json" Link="Data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\sprites\atlas\atlas.json" Link="Data/atlas.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Motor do mundo (B4a): layouts de todos os mapas, fixtures de layout do smoke e o catálogo de objetos de teste. -->
    <None Include="..\assets\maps\**\layout_*.json" Link="Layouts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\src\Testing\Fixtures\fixture_*.json" Link="Layouts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\src\Testing\Fixtures\objects_*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\maps\lights.json" Link="Data/lights.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
