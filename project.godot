; Engine configuration file.
; Configurações descritas no CLAUDE.md, seção 2. Edite pelo editor do Godot quando possível.

config_version=5

[application]

config/name="Véspera"
config/description="RPG de ação 2D em pixel art: caçadores fecham as Brechas que abrem toda véspera em Lumeira."
config/version="0.1.0-dev"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.105882, 0.121569, 0.231373, 1)
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/Autoload/EventBus.cs"
AudioManager="*res://src/Autoload/AudioManager.cs"
SaveService="*res://src/Autoload/SaveService.cs"
Database="*res://src/Autoload/Database.cs"
GameManager="*res://src/Autoload/GameManager.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Vespera"

[gui]

theme/custom="res://src/UI/Theme/vespera_theme.tres"

