; Engine configuration file.
; v2: base 1920x1080, canvas_items, filtro Linear (arte pintada em alta resolucao).

config_version=5

[application]

config/name="Véspera"
config/description="RPG de ação 2D em pixel art: caçadores fecham as Brechas que abrem toda véspera em Lumeira."
config/version="0.2.0-dev"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.105882, 0.121569, 0.231373, 1)
config/icon="res://assets/v2/icone/icone_app.png"

[autoload]

SceneRouter="*res://src/Game/Boot/SceneRouter.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="Vespera"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_hitbox"
2d_physics/layer_5="enemy_hitbox"

[physics]

common/physics_interpolation=true
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.105882, 0.121569, 0.231373, 1)
