# Normaliza finais de linha (texto entra no repo como LF)
* text=auto eol=lf

# Scripts do Windows mantêm CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf

# Arquivos do Godot e .NET são texto
*.cs text diff=csharp
*.tscn text
*.tres text
*.godot text
*.cfg text
*.csproj text
*.sln text eol=crlf

# Arte, áudio e fontes vão para o Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.ase filter=lfs diff=lfs merge=lfs -text
*.pxo filter=lfs diff=lfs merge=lfs -text

# Binários que não devem ter diff
*.ico binary
*.svg text
