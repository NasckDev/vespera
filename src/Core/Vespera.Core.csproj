<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Lógica pura do jogo. NÃO referencia Godot (CLAUDE.md, seção 3).
    Por ser um projeto separado, qualquer `using Godot;` aqui falha na compilação.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vespera.Core</RootNamespace>
    <AssemblyName>Vespera.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
