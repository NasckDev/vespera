  "questions": [
    {
      "if": [
        "arrival_done"
      ],
      "text": "De quem era a lanterna? Ela acendeu sozinha quando a Brecha abriu."
    },
    {
      "if": [
        "benicio_selo"
      ],
      "text": "Por que o selo queimou sozinho? O Benício nunca viu isso."
    },
    {
      "if": [
        "lis_segredo"
      ],
      "text": "Por que os monstros não chegam perto da Lis?"
    },
    {
      "if": [
        "odete_marisa"
      ],
      "text": "Quem foi Marisa? A Odete esperou ela voltar."
    },
    {
      "if": [
        "lanterna_m"
      ],
      "text": "Por que a lanterna \"M.\" é igual à minha?"
    },
    {
      "if": [
        "met_vigia"
      ],
      "text": "Quem é o Vigia? Ele reconheceu a sua lanterna."
    },
    {
      "if": [
        "ato5_confissao"
      ],
      "text": "Por que o sino emudeceu? Foi o Benício que tocou."
    }
